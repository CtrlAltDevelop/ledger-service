# Copy to .env for docker compose, or export in your shell for local runs.

# Required outside DEBUG. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger
DB_CONN_MAX_AGE=60

# Snapshot an account's balance every N entries.
LEDGER_SNAPSHOT_EVERY=500

# Outbox worker target: "log" writes events to stdout, "redis" appends them to
# a Redis stream (install the `redis` extra).
LEDGER_OUTBOX_PUBLISHER=log
LEDGER_OUTBOX_STREAM=ledger.events
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
